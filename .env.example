# Nusxa oling: .env
APP_PORT=8787
APP_LOGIN=sotuvchi
APP_PASSWORD=ombor2026
# Ma'lumotlar papkasi (SQLite fayl va sessiya kaliti shu yerda)
DATA_DIR=data
# Hozircha faqat: sqlite
DB_DRIVER=sqlite
# HTTPS orqali ishlatilsa: 1
SECURE_COOKIES=0

# Uzum Market integratsiyasi (ixtiyoriy).
# Kalit: Uzum sotuvchi kabineti → Sozlamalar → API kalitlari. Bo'sh qolsa, integratsiya o'chiq.
UZUM_API_KEY=
# Faqat shu do'konlar (vergul bilan). Bo'sh — kalitga tegishli barcha do'konlar.
UZUM_SHOP_IDS=
# Avtomatik yangilash oralig'i (daqiqa). 0 — faqat qo'lda.
UZUM_SYNC_MINUTES=15
