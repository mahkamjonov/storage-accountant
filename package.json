{
  "name": "ombor-hisobi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Uzum Market sotuvchisi uchun ombor hisobi (MVP)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch-path=server --watch-path=domain --import tsx server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --import tsx server/index.ts",
    "seed": "node --import tsx server/seed.ts",
    "uzum:tekshir": "node --import tsx server/uzum-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
